{
  "name": "cpp20-shared-sdk",
  "version-string": "0.1.0",
  "description": "Shared C++20 SDK for Windows and Ubuntu; conditional closed-source distribution",
  "dependencies": [
    "assimp",
    "benchmark",
    {
      "name": "boost",
      "$comment": "官方完整 Boost 1.92.0，含 geometry 和 Boost.Python；不启用可选 mpi",
      "default-features": false
    },
    {
      "name": "ceres",
      "default-features": false,
      "features": [
        "schur"
      ]
    },
    "clipper2",
    "console-bridge",
    "eigen3",
    "flann",
    "freetype",
    "glog",
    "gmp",
    "gtest",
    "libffi",
    "libmodbus",
    "lpeg",
    "lua",
    "lz4",
    "mpdecimal",
    "mpfr",
    "nanoflann",
    "nlohmann-json",
    "nu-book-zxing-cpp",
    "octomap",
    "ompl",
    {
      "name": "opencascade",
      "default-features": false,
      "features": [
        "freetype",
        "rapidjson",
        "tbb",
        "vtk"
      ]
    },
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "calib3d",
        "eigen",
        "highgui",
        "intrinsics",
        "jpeg",
        "png",
        "tbb",
        "tiff",
        "webp",
        "world"
      ]
    },
    "paho-mqttpp3",
    {
      "name": "pcl",
      "default-features": false,
      "features": [
        "surface-on-nurbs"
      ]
    },
    "pybind11",
    {
      "name": "python3",
      "$comment": "本地 overlay：3.15.2；自由线程共享 SDK"
    },
    "qhull",
    "qt-advanced-docking-system",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "async-io",
        "brotli",
        "concurrent",
        "dnslookup",
        "freetype",
        "gui",
        "harfbuzz",
        "icu",
        "jpeg",
        "network",
        "opengl",
        "openssl",
        "pcre2",
        "png",
        "sessionmanager",
        "sql-sqlite",
        "testlib",
        "widgets",
        "zstd"
      ]
    },
    {
      "name": "qtbase",
      "$comment": "Windows 部署工具；不作为业务程序运行依赖。",
      "default-features": false,
      "features": [
        "windeployqt"
      ],
      "platform": "windows"
    },
    {
      "name": "qtbase",
      "$comment": "Linux 使用 Fontconfig 和 X11/XWayland；xcb-xlib、egl 分别补齐 XCB 的 GLX、EGL 路径，xcb-sm 接入 X11 会话管理。Windows 使用原生字体与窗口接口。",
      "default-features": false,
      "features": [
        "egl",
        "fontconfig",
        "xcb",
        "xcb-sm",
        "xcb-xlib"
      ],
      "platform": "linux"
    },
    "qtimageformats",
    "qtserialbus",
    "qtserialport",
    "qtsvg",
    {
      "name": "qttools",
      "default-features": false,
      "features": [
        "linguist"
      ]
    },
    "quill",
    "rapidjson",
    "sol2",
    "tbb",
    {
      "name": "tcl",
      "$comment": "本地 overlay：9.0.3#3"
    },
    "tinyxml2",
    "urdfdom",
    "urdfdom-headers",
    {
      "name": "vtk",
      "default-features": false,
      "features": [
        "opengl",
        "tbb"
      ]
    },
    "zlib"
  ],
  "default-features": [
    "custom"
  ],
  "features": {
    "custom": {
      "description": "Complete SDK including missing ports and license/platform overlays",
      "dependencies": [
        {
          "name": "cccorelib",
          "$comment": "本地 overlay：2024.04.10"
        },
        {
          "name": "cgal",
          "$comment": "本地 overlay：6.2.1#1"
        },
        {
          "name": "coal",
          "$comment": "本地 overlay：3.0.4"
        },
        {
          "name": "ifcopenshell",
          "$comment": "本地 overlay：0.8.6"
        },
        {
          "name": "lexilla",
          "$comment": "本地 overlay：5.4.6"
        },
        {
          "name": "nodeeditor",
          "$comment": "本地 overlay：3.0.16"
        },
        {
          "name": "pinocchio",
          "features": [
            "urdf"
          ],
          "$comment": "本地 overlay：4.1.0"
        },
        {
          "name": "saribbon",
          "$comment": "本地 overlay：2.8.0"
        },
        {
          "name": "scintilla",
          "$comment": "本地 overlay：5.6.7"
        },
        {
          "name": "scintillua",
          "$comment": "本地 overlay：6.7"
        },
        {
          "name": "tk",
          "$comment": "本地 overlay：9.0.3"
        }
      ]
    }
  },
  "$comment": "Boost 完整包固定为 1.92.0，各组件由当前固定 baseline 配套提供；Qt 官方模块随 baseline 和依赖解析。升级 baseline 时须一起评估 Boost 组件版本。",
  "overrides": [
    {
      "name": "boost",
      "version": "1.92.0"
    },
    {
      "name": "assimp",
      "version": "6.0.5"
    },
    {
      "name": "benchmark",
      "version-semver": "1.9.5"
    },
    {
      "name": "ceres",
