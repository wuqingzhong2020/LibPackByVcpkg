vcpkg_check_linkage(ONLY_DYNAMIC_LIBRARY)
vcpkg_from_github(
    OUT_SOURCE_PATH SOURCE_PATH
    REPO CloudCompare/CCCoreLib
    REF cac3533c6b9b773d33122a393533e2a328241d5b
    SHA512 5e65d54aa77b2abe14ed5e48cf468683f29359c2c3c2fadaf26cc9a32638e925f5dbb0508703a92e6c06930c4f60b5771a3c430a16e998713a10a8897a4cdeae
    PATCHES sdk.patch
)
vcpkg_from_github(
    OUT_SOURCE_PATH NANOFLANN_PATH
    REPO jlblancoc/nanoflann
    REF 2f54b8eb07c719bc605445e4ec44d61240f5a2ce
    SHA512 83c17864e820d18c3bb35ad4e0eb59b5c728ed3fdd133ed3dea4423a0951bfc739e8c8ace0c09f5016d9f9d9f3cb005b89c2e1d7c0da67d6a6b8a8680c9976d0
)
file(COPY "${NANOFLANN_PATH}/" DESTINATION "${SOURCE_PATH}/extern/nanoflann")
vcpkg_cmake_configure(
    SOURCE_PATH "${SOURCE_PATH}"
    OPTIONS
        -DCCCORELIB_SHARED=ON -DCCCORELIB_USE_TBB=ON
        -DCCCORELIB_USE_QT_CONCURRENT=OFF -DCCCORELIB_USE_CGAL=OFF
        -DCCCORELIB_SCALAR_DOUBLE=OFF -DCCCORELIB_USE_VISUAL_LEAK_DETECTOR=OFF
        -DNANOFLANN_BUILD_BENCHMARKS=OFF -DNANOFLANN_BUILD_EXAMPLES=OFF
        -DNANOFLANN_BUILD_TESTS=OFF -DCCACHE_PROGRAM=
)
vcpkg_cmake_install()
vcpkg_cmake_config_fixup(PACKAGE_NAME CCCoreLib CONFIG_PATH lib/cmake/CCCoreLib)
vcpkg_copy_pdbs()
file(REMOVE_RECURSE "${CURRENT_PACKAGES_DIR}/debug/include" "${CURRENT_PACKAGES_DIR}/debug/share")
file(REMOVE_RECURSE "${CURRENT_PACKAGES_DIR}/licenses" "${CURRENT_PACKAGES_DIR}/debug/licenses")
vcpkg_install_copyright(FILE_LIST "${SOURCE_PATH}/LICENSE.txt" "${SOURCE_PATH}/LICENSE-MIT.txt" "${NANOFLANN_PATH}/COPYING")
