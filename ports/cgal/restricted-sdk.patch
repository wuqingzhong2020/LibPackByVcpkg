diff --git a/Installation/cmake/modules/CGAL_InstallWhitelist.cmake b/Installation/cmake/modules/CGAL_InstallWhitelist.cmake
new file mode 100644
--- /dev/null
+++ b/Installation/cmake/modules/CGAL_InstallWhitelist.cmake
@@ -0,0 +1,259 @@
+# Local installation policy for CGAL 6.2.1.
+# See Installation/INSTALL_WHITELIST.md before changing this list.
+# This is deliberately not an option to switch back to installing every package.
+
+set(CGAL_INSTALL_WHITELIST_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}")
+# Exclude only local installer implementation files, never dependency names.
+# In particular, *GLES* also matched SingleSource on Windows.
+set(CGAL_INSTALL_EXCLUDED_MODULE_PATTERNS
+  "CGAL_InstallWhitelist.cmake" "CGAL_InstallWhitelistGuard.cmake.in"
+  "CGALInstallSelection.cmake.in" "CGAL_install_policy.h.in")
+set(CGAL_INSTALL_MODULE_EXCLUSIONS)
+foreach(pattern IN LISTS CGAL_INSTALL_EXCLUDED_MODULE_PATTERNS)
+  list(APPEND CGAL_INSTALL_MODULE_EXCLUSIONS PATTERN "${pattern}" EXCLUDE)
+endforeach()
+
+function(cgal_install_whitelisted_headers)
+  # Canonicalize both sides of relative include resolution on Windows.
+  # Mixing an 8.3 source path with its long path would hide CGAL edges.
+  file(REAL_PATH "${CGAL_SOURCE_DIR}" CGAL_SOURCE_DIR)
+  if(NOT CGAL_BRANCH_BUILD OR NOT CGAL_VERSION_PUBLIC_RELEASE_VERSION STREQUAL "6.2.1")
+    message(FATAL_ERROR "The installation whitelist requires the CGAL 6.2.1 Git source layout. Review it before upgrading.")
+  endif()
+
+  # These packages have been reviewed for use in proprietary applications.
+  # LGPL is one accepted license family, not the sole eligibility criterion.
+  # External dependencies are supplied and licensed by the consuming project.
+  set(approved_packages
+    Algebraic_foundations Algebraic_kernel_d Arithmetic_kernel BGL
+    Cartesian_kernel CGAL_Core CGAL_ImageIO CGAL_ipelets Circulator Combinatorial_map
+    Distance_2 Distance_3 Filtered_kernel Generalized_map Generator HalfedgeDS
+    Hash_map Homogeneous_kernel Installation Intersections_2 Intersections_3
+    Interval_support Kernel_23 Kernel_d LEDA Linear_cell_complex Mesher_level
+    Modifier Modular_arithmetic NewKernel_d Number_types Optimisation_basic
+    Polygon Polynomial Principal_component_analysis_LGPL Profiling_tools
+    Property_map Random_numbers Solver_interface Spatial_sorting STL_Extension
+    Stream_support Subdivision_method_3 Testsuite Union_find Weights)
+  set(CGAL_INSTALL_PACKAGE_WHITELIST "${approved_packages}" CACHE STRING
+    "CGAL 6.2.1 packages to install (semicolon separated; only license-reviewed packages)")
+  # Migrate the previous complete default, but preserve custom subsets.
+  set(previous_default ${approved_packages})
+  list(REMOVE_ITEM previous_default LEDA CGAL_ipelets)
+  list(SORT previous_default)
+  set(cached_selection ${CGAL_INSTALL_PACKAGE_WHITELIST})
+  list(REMOVE_DUPLICATES cached_selection)
+  list(SORT cached_selection)
+  if("${cached_selection}" STREQUAL "${previous_default}")
+    set(CGAL_INSTALL_PACKAGE_WHITELIST "${approved_packages}" CACHE STRING
+      "CGAL 6.2.1 packages to install (semicolon separated; only license-reviewed packages)" FORCE)
+    message(STATUS "CGAL installation whitelist: upgraded the previous 44-package default to 46 license-reviewed packages.")
+  endif()
+  set(selected_packages ${CGAL_INSTALL_PACKAGE_WHITELIST})
+  list(REMOVE_DUPLICATES selected_packages)
+  list(SORT selected_packages)
+  if(NOT "Installation" IN_LIST selected_packages)
+    message(FATAL_ERROR "CGAL_INSTALL_PACKAGE_WHITELIST must contain Installation.")
+  endif()
+  if(NOT CGAL_INSTALL_INC_DIR STREQUAL "include")
+    message(FATAL_ERROR "The restricted CGAL SDK requires CGAL_INSTALL_INC_DIR=include.")
+  endif()
+  if(NOT CGAL_INSTALL_DOC_DIR)
+    message(FATAL_ERROR "CGAL_INSTALL_DOC_DIR must be set so that license texts and the selection report are installed.")
+  endif()
+  foreach(directory CGAL_INSTALL_CMAKE_DIR CGAL_INSTALL_DOC_DIR)
+    if(IS_ABSOLUTE "${${directory}}" OR "${${directory}}" MATCHES "(^|[/\\\\])\\.\\.([/\\\\]|$)")
+      message(FATAL_ERROR "${directory} must be a relative directory inside the SDK prefix.")
+    endif()
+  endforeach()
+
+  set(headers)
+  set(excluded)
+  # Match reviewed expressions exactly: never accept a license merely because
+  # it contains "MIT", etc. An AND with GPL still imposes the GPL obligations.
+  # New packages still require review and addition to approved_packages above,
+  # including installation of their license texts and notices.
+  set(approved_spdx
+    "LGPL-2.1-only" "LGPL-2.1-or-later" "LGPL-3.0-only" "LGPL-3.0-or-later"
+    "LGPL-3.0-or-later OR LicenseRef-Commercial"
+    "MIT" "BSD-2-Clause" "BSD-3-Clause" "Apache-2.0" "BSL-1.0" "Zlib"
+    "ISC" "CC0-1.0" "MPL-2.0")
+  set(approved_package_licenses ${approved_spdx}
+    "LGPL (v2.1 or later)" "LGPL (v3 or later)")
+  foreach(package IN LISTS selected_packages)
+    if(NOT package IN_LIST approved_packages)
+      message(FATAL_ERROR "Package '${package}' is not in the approved license whitelist.")
+    endif()
+    set(package_root "${CGAL_SOURCE_DIR}/${package}")
+    set(license_file "${package_root}/package_info/${package}/license.txt")
+    if(NOT EXISTS "${license_file}")
+      message(FATAL_ERROR "Missing package license metadata: ${license_file}")
+    endif()
+    file(READ "${license_file}" package_license)
+    string(STRIP "${package_license}" package_license)
+    if(NOT package_license IN_LIST approved_package_licenses)
+      message(FATAL_ERROR "Package license needs review for proprietary distribution: ${package}: ${package_license}")
+    endif()
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${license_file}")
+    file(GLOB_RECURSE package_headers CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE
+      RELATIVE "${package_root}/include" "${package_root}/include/CGAL/*")
+    foreach(header IN LISTS package_headers)
+      # Attic contains obsolete ImageIO interfaces with unresolved includes.
+      # The license generator files are development metadata, not C++ headers.
+      if(header MATCHES "^CGAL/ImageIO/Attic/"
+          OR header MATCHES "^CGAL/license/(generate_files\\.cmake|gpl_package_list\\.txt|README\\.md)$")
+        list(APPEND excluded "${package}: ${header} [development/obsolete file]")
+        continue()
+      endif()
+      set(source "${package_root}/include/${header}")
+      file(STRINGS "${source}" spdx_line REGEX "SPDX-License-Identifier:" LIMIT_COUNT 1)
+      string(REGEX REPLACE ".*SPDX-License-Identifier:[ \t]*" "" spdx "${spdx_line}")
+      string(STRIP "${spdx}" spdx)
+      if(NOT spdx IN_LIST approved_spdx)
+        message(FATAL_ERROR "Unreviewed file license '${spdx}' in ${source}")
+      endif()
+      string(SHA256 key "${header}")
+      if(DEFINED source_${key})
+        message(FATAL_ERROR "Duplicate install header: ${header}")
+      endif()
+      set(source_${key} "${source}")
+      set(owner_${key} "${package}")
+      set(available_${key} TRUE)
+      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
+      list(APPEND headers "${header}")
+    endforeach()
+  endforeach()
+  list(SORT headers)
+
+  # Conservative literal-include analysis, not a C++ preprocessor. A reference
+  # to an excluded CGAL header excludes its caller, including conditional uses.
+  # Only dead VTK code and the non-header-only configuration path are exempt.
+  # External includes do not exclude a header: dependencies are optional until
+  # the consuming project selects an interface that needs them.
+  set(disabled_edges
+    "^CGAL/Image_3_impl\\.h\\|CGAL/Image_3_vtk_interface\\.h$"
+    "^CGAL/config\\.h\\|CGAL/compiler_config\\.h$")
+  foreach(header IN LISTS headers)
+    string(SHA256 key "${header}")
+    file(STRINGS "${source_${key}}" include_lines REGEX "^[ \t]*#[ \t]*include([ \t]+|[<\"])")
+    foreach(line IN LISTS include_lines)
+      if(NOT line MATCHES "^[ \t]*#[ \t]*include[ \t]*([<\"])([^>\"]+)[>\"]")
+        message(FATAL_ERROR "Non-literal include needs manual whitelist review: ${header}: ${line}")
+      endif()
+      set(delimiter "${CMAKE_MATCH_1}")
+      set(dependency "${CMAKE_MATCH_2}")
+      if(delimiter STREQUAL "\"")
+        get_filename_component(source_dir "${source_${key}}" DIRECTORY)
+        if(EXISTS "${source_dir}/${dependency}")
+          get_filename_component(resolved "${source_dir}/${dependency}" ABSOLUTE)
+          file(RELATIVE_PATH dependency
+            "${CGAL_SOURCE_DIR}/${owner_${key}}/include" "${resolved}")
+        endif()
+      endif()
+      set(disabled FALSE)
+      foreach(pattern IN LISTS disabled_edges)
+        if("${header}|${dependency}" MATCHES "${pattern}")
+          set(disabled TRUE)
+          break()
+        endif()
+      endforeach()
+      if(disabled)
+        continue()
+      endif()
+      if(dependency MATCHES "^CGAL/")
+        list(APPEND dependencies_${key} "${dependency}")
+      endif()
+    endforeach()
+  endforeach()
+  set(changed TRUE)
+  while(changed)
+    set(changed FALSE)
+    foreach(header IN LISTS headers)
+      string(SHA256 key "${header}")
+      if(NOT available_${key})
+        continue()
+      endif()
+      foreach(dependency IN LISTS dependencies_${key})
+        string(SHA256 dependency_key "${dependency}")
+        if(NOT available_${dependency_key})
+          set(available_${key} FALSE)
+          set(reason_${key} "requires excluded/missing ${dependency}")
+          set(changed TRUE)
+          break()
+        endif()
+      endforeach()
+    endforeach()
+  endwhile()
+
+  set(installed_headers)
+  foreach(header IN LISTS headers)
+    string(SHA256 key "${header}")
+    if(available_${key})
+      list(APPEND installed_headers "${header}")
+    else()
+      list(APPEND excluded "${owner_${key}}: ${header} [${reason_${key}}]")
+    endif()
+  endforeach()
+  foreach(required CGAL/config.h CGAL/license.h CGAL/version.h)
+    if(NOT required IN_LIST installed_headers)
+      message(FATAL_ERROR "Selection removed essential header ${required}. Restore the default package whitelist.")
+    endif()
+  endforeach()
+
+  # Only the installed copy of config.h is changed. Keep upstream copyright
+  # and license notices, and make this local modification explicit.
+  set(output_dir "${CGAL_BINARY_DIR}/install-whitelist")
+  file(MAKE_DIRECTORY "${output_dir}")
+  file(READ "${CGAL_SOURCE_DIR}/Installation/include/CGAL/config.h" config_header)
+  file(READ "${CGAL_INSTALL_WHITELIST_MODULE_DIR}/config/CGAL_install_policy.h.in" policy_header)
+  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
+    "${CGAL_INSTALL_WHITELIST_MODULE_DIR}/config/CGAL_install_policy.h.in")
+  if(NOT config_header MATCHES "#define CGAL_CONFIG_H")
+    message(FATAL_ERROR "CGAL/config.h changed; review the installed policy insertion point.")
+  endif()
+  string(REPLACE "#define CGAL_CONFIG_H" "#define CGAL_CONFIG_H\n${policy_header}" config_header "${config_header}")
+  file(WRITE "${output_dir}/config.h" "${config_header}")
+
+  # This guard runs before any SDK files are copied; never delete old SDK files.
+  configure_file("${CGAL_INSTALL_WHITELIST_MODULE_DIR}/CGAL_InstallWhitelistGuard.cmake.in"
+    "${output_dir}/check-prefix.cmake" @ONLY)
+  install(SCRIPT "${output_dir}/check-prefix.cmake")
+  foreach(header IN LISTS installed_headers)
+    string(SHA256 key "${header}")
+    get_filename_component(header_dir "${header}" DIRECTORY)
+    if(header STREQUAL "CGAL/config.h")
+      set(source "${output_dir}/config.h")
+    elseif(header STREQUAL "CGAL/version.h")
+      set(source "${CGAL_BINARY_DIR}/include/CGAL/version.h")
+    else()
+      set(source "${source_${key}}")
+    endif()
+    install(FILES "${source}" DESTINATION "${CGAL_INSTALL_INC_DIR}/${header_dir}")
+  endforeach()
+
+  set(components)
+  foreach(component Core ImageIO)
+    if("CGAL_${component}" IN_LIST selected_packages)
+      list(APPEND components "${component}")
+    endif()
+  endforeach()
+  configure_file("${CGAL_INSTALL_WHITELIST_MODULE_DIR}/CGALInstallSelection.cmake.in"
+    "${output_dir}/CGALInstallSelection.cmake" @ONLY)
+  install(FILES "${output_dir}/CGALInstallSelection.cmake" DESTINATION "${CGAL_INSTALL_CMAKE_DIR}")
+  list(SORT excluded)
+  string(REPLACE ";" "\n" package_report "${selected_packages}")
+  string(REPLACE ";" "\n" header_report "${installed_headers}")
+  string(REPLACE ";" "\n" excluded_report "${excluded}")
+  file(WRITE "${output_dir}/INSTALL_WHITELIST.txt"
+    "CGAL 6.2.1 local installation policy\nSee INSTALL_WHITELIST.md for limitations and license obligations.\nExternal dependencies are not filtered or bundled; review them when using an interface.\n\nSelected license-reviewed packages:\n${package_report}\n\nInstalled headers:\n${header_report}\n\nExcluded headers from selected packages:\n${excluded_report}\n")
+  install(FILES "${output_dir}/INSTALL_WHITELIST.txt"
+    "${CGAL_SOURCE_DIR}/Installation/INSTALL_WHITELIST.md" DESTINATION "${CGAL_INSTALL_DOC_DIR}")
+  foreach(package IN LISTS selected_packages)
+    install(FILES "${CGAL_SOURCE_DIR}/${package}/package_info/${package}/license.txt"
+      DESTINATION "${CGAL_INSTALL_DOC_DIR}/package_licenses/${package}")
+  endforeach()
+  list(LENGTH installed_headers header_count)
+  list(LENGTH selected_packages package_count)
+  list(LENGTH excluded excluded_count)
+  message(STATUS "CGAL installation whitelist: ${package_count} packages, ${header_count} headers, ${excluded_count} exclusions")
+  message(STATUS "CGAL installation report: ${output_dir}/INSTALL_WHITELIST.txt")
+endfunction()
diff --git a/Installation/cmake/modules/CGAL_InstallWhitelistGuard.cmake.in b/Installation/cmake/modules/CGAL_InstallWhitelistGuard.cmake.in
new file mode 100644
--- /dev/null
+++ b/Installation/cmake/modules/CGAL_InstallWhitelistGuard.cmake.in
@@ -0,0 +1,25 @@
+# Generated at configuration time. Checked before installing any SDK files.
+cmake_policy(PUSH)
+cmake_policy(SET CMP0057 NEW)
+set(_cgal_expected_headers "@installed_headers@")
+set(_cgal_include "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CGAL_INSTALL_INC_DIR@")
+file(GLOB_RECURSE _cgal_existing LIST_DIRECTORIES FALSE
+  RELATIVE "${_cgal_include}" "${_cgal_include}/CGAL/*")
+foreach(_cgal_header IN LISTS _cgal_existing)
+  if(NOT _cgal_header IN_LIST _cgal_expected_headers)
+    message(FATAL_ERROR
+      "CGAL install prefix contains a header outside the current whitelist: ${_cgal_include}/${_cgal_header}\nChoose a new empty SDK prefix or clean the previous CGAL installation manually. No files were deleted.")
+  endif()
+endforeach()
+if(EXISTS "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CGAL_INSTALL_CMAKE_DIR@/demo")
+  message(FATAL_ERROR "Old demo resources outside the license-reviewed SDK exist in this prefix. Use a new empty SDK prefix.")
+endif()
+set(_cgal_excluded_patterns "@CGAL_INSTALL_EXCLUDED_MODULE_PATTERNS@")
+foreach(_cgal_pattern IN LISTS _cgal_excluded_patterns)
+  file(GLOB_RECURSE _cgal_old_modules
+    "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CGAL_INSTALL_CMAKE_DIR@/${_cgal_pattern}")
+  if(_cgal_old_modules)
+    message(FATAL_ERROR "Old excluded CGAL CMake files exist: ${_cgal_old_modules}. Use a new empty SDK prefix.")
+  endif()
+endforeach()
+cmake_policy(POP)
