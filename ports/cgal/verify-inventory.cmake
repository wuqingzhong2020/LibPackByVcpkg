file(GLOB_RECURSE headers LIST_DIRECTORIES FALSE RELATIVE "${CURRENT_PACKAGES_DIR}/include" "${CURRENT_PACKAGES_DIR}/include/*")
list(SORT headers)
string(JOIN "\n" inventory ${headers})
string(APPEND inventory "\n")
string(SHA256 inventory_hash "${inventory}")
if(NOT inventory_hash STREQUAL "dc5a5f1d7a3cc103a2d4e51af5d38b85a4951d3d7eb47c0e99156ce4a9bf5f5e")
    message(FATAL_ERROR "CGAL header inventory differs from the reviewed 1454-file subset")
endif()
file(READ "${CURRENT_PACKAGES_DIR}/include/CGAL/config.h" config)
if(NOT config MATCHES "#  define CGAL_LICENSE_ERROR 1")
    message(FATAL_ERROR "Missing CGAL license guard")
endif()
