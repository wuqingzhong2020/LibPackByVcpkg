{
  "name": "saribbon",
  "version-string": "2.8.0",
  "description": "SARibbonBar SDK",
  "homepage": "https://github.com/czyt1988/SARibbon",
  "license": "MIT",
  "supports": "(windows & !uwp & !mingw) | linux",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "opengl",
        "widgets"
      ]
    },
    {
      "name": "qttools",
      "host": true,
      "default-features": false,
      "features": [
        "linguist"
      ]
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ]
}
