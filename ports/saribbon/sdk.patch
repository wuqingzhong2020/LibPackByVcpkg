--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -59,31 +59,17 @@ if(SARIBBON_USE_FRAMELESS_LIB)
     endif()
 endif()
 
-# 如果是使用frameless库，需要c++17，否则c++14
-# Qt6 需要 C++17，Qt5 使用 C++14
-if(${QT_VERSION_MAJOR} GREATER_EQUAL 6)
-    set(CMAKE_CXX_STANDARD 17)
-    set(CMAKE_CXX_STANDARD_REQUIRED ON)
-    if(MSVC)
-        # 不要显式添加 /std:c++17，让 CMake 自动处理
-        # Qt6 的 CMake 工具链会自动添加正确的标准选项
-    endif()
-    message(STATUS "Qt6 detected, using C++17")
-elseif(_SARIBBON_USE_FRAMELESS_LIB)
-    set(CMAKE_CXX_STANDARD 17)
-    set(CMAKE_CXX_STANDARD_REQUIRED ON)
-    if(MSVC)
-        set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} /std:c++17")
-    endif()
-    message(STATUS "The current QT version can use the frameless library and enable C++17")
-else()
-    set(CMAKE_CXX_STANDARD 14)
-    set(CMAKE_CXX_STANDARD_REQUIRED ON)
-    if(MSVC)
-        set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} /std:c++14")
-    endif()
-    message(STATUS "The current qt version cannot use the frameless library, enable C++14")
-endif()
+# Respect a C++ standard selected by the parent build. Keep the upstream
+# Qt-dependent defaults only for standalone builds that did not select one.
+if(NOT CMAKE_CXX_STANDARD)
+    if(${QT_VERSION_MAJOR} GREATER_EQUAL 6 OR _SARIBBON_USE_FRAMELESS_LIB)
+        set(CMAKE_CXX_STANDARD 17)
+    else()
+        set(CMAKE_CXX_STANDARD 14)
+    endif()
+endif()
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+message(STATUS "Using C++${CMAKE_CXX_STANDARD}")
 
 set(CMAKE_DEBUG_POSTFIX "d" CACHE STRING "add a postfix, usually d on windows")
 set(CMAKE_RELEASE_POSTFIX "" CACHE STRING "add a postfix, usually empty on windows")
