--- a/src/SARibbonBar/CMakeLists.txt
+++ b/src/SARibbonBar/CMakeLists.txt
@@ -30,8 +30,8 @@ SET(SACOLOR_SOURCE_FILES
 
 # header files
 # cn:头文件
-SET(SARIBBON_HEADER_FILES
-    SARibbonBarVersionInfo.h
+SET(SARIBBON_HEADER_FILES
+    ${SARIBBON_VERSION_HEADER}
     SARibbonGlobal.h
     SARibbonQt5Compat.hpp
     SARibbonUtil.h
@@ -211,11 +211,15 @@ target_include_directories(${SARIBBON_LIB_NAME} PUBLIC
     $<INSTALL_INTERFACE:include/${SARIBBON_LIB_NAME}>
     $<BUILD_INTERFACE:${CMAKE_CURRENT_LIST_DIR}>
 )
-if(MSVC)
-    # To unbreak std::min/max
-    target_compile_definitions(${SARIBBON_LIB_NAME} PRIVATE NOMINMAX)
-    message(STATUS "macros predefined:#define NOMINMAX")
-endif()
+if(MSVC)
+    # To unbreak std::min/max
+    target_compile_definitions(${SARIBBON_LIB_NAME} PRIVATE NOMINMAX)
+    # The upstream UTF-8 sources contain Chinese comments.  Without an
+    # explicit source charset, MSVC under code page 936 can splice lines and
+    # misparse otherwise valid C++ source.
+    target_compile_options(${SARIBBON_LIB_NAME} PRIVATE /utf-8)
+    message(STATUS "macros predefined:#define NOMINMAX")
+endif()
 
